79"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="TextBox 7"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="2193906" y="2119061"/><a:ext cx="19756178" cy="1730504"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:ln><a:solidFill><a:schemeClr val="tx1"/></a:solidFill></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="en-US" sz="3200" b="1" dirty="0"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill><a:latin typeface="Narkisim" panose="020E0502050101010101" pitchFamily="34" charset="-79"/><a:cs typeface="Narkisim" panose="020E0502050101010101" pitchFamily="34" charset="-79"/></a:rPr><a:t>Graduation Project</a:t></a:r></a:p><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="en-US" sz="3200" b="1" dirty="0"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill></a:rPr><a:t>Supervisor Name</a:t></a:r></a:p><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="en-US" sz="3200" b="1" dirty="0"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill></a:rPr><a:t>Students Name and ID</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="9" name="TextBox 8"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="390566" y="4216909"/><a:ext cx="7744968" cy="646331"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="tx1"/></a:solidFill></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle><a:defPPr><a:defRPr lang="en-US"/></a:defPPr><a:lvl1pPr><a:defRPr sz="3600" b="1"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/><a:cs typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/></a:defRPr></a:lvl1pPr></a:lstStyle><a:p><a:pPr algn="ctr"/><a:r><a:rPr lang="en-US" dirty="0"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill></a:rPr><a:t>Abstract</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="TextBox 12"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="412892" y="4879016"/><a:ext cx="7747000" cy="4524315"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" sz="2400" i="0" u="none" strike="noStrike" dirty="0"><a:solidFill><a:srgbClr val="000000"/></a:solidFill><a:effectLst/></a:rPr><a:t>The KSA Traffic Practitioner project aims to improve road safety in Saudi Arabia by introducing a camera-free, IoT- and mobile-based speed monitoring system. Using GPS and Bluetooth, the system offers real-time, in-vehicle speed tracking—especially useful in rural areas lacking traditional camera coverage. It promotes safer driving through user-specific alerts and supports integration with existing traffic management frameworks. Aligned with Vision 2030, the project emphasizes safety, innovation, and accessibility, providing a scalable and user-friendly solution to nationwide traffic enforcement challenges. This continuous monitoring solution also aligns with Saudi Arabia's Vision 2030 goals.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="16" name="TextBox 15"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="390566" y="9683346"/><a:ext cx="7744968" cy="646331"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="tx1"/></a:solidFill></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle><a:defPPr><a:defRPr lang="en-US"/></a:defPPr><a:lvl1pPr algn="ctr"><a:defRPr sz="3600" b="1"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill><a:latin typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/><a:cs typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/></a:defRPr></a:lvl1pPr></a:lstStyle><a:p><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Introduction</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="38" name="TextBox 37"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="16902209" y="30148167"/><a:ext cx="7744968" cy="646331"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="tx1"/></a:solidFill></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle><a:defPPr><a:defRPr lang="en-US"/></a:defPPr><a:lvl1pPr algn="ctr"><a:defRPr sz="3600" b="1"><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill><a:latin typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/><a:cs typeface="Aharoni" panose="02010803020104030203" pitchFamily="2" charset="-79"/></a:defRPr></a:lvl1pPr></a:lstStyle><a:p><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Conclusions</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="43" name="TextBox 42"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="16902209" y="30962273"/><a:ext cx="7744968" cy="5262979"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr lvl="0" algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>The proposed IoT-based speed monitoring system provides a smart, camera-free alternative to traditional traffic enforcement methods in Saudi Arabia. </a:t></a:r></a:p><a:p><a:pPr lvl="0" algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>By using GPS and Bluetooth technologies, the system enables real-time speed tracking from inside the vehicle, making it effective even in areas without camera coverage.</a:t></a:r></a:p><a:p><a:pPr lvl="0" algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t> The mobile application not only alerts users immediately when exceeding speed limits but also stores speed logs that can be reviewed by drivers and traffic authorities. This approach improves driver awareness, reduces response time to violations, and supports proactive enforcement. Overall, the system is low-cost, scalable, and aligns with Saudi Arabia’s Vision 2030 objectives to enhance public safety through technological innovation.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="44" name="Rectangle 43"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="50800" y="3795882"/><a:ext cx="25192038" cy="274320"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="FFFF00"/></a:solidFill><a:ln w="38100"><a:solidFill><a:schemeClr val="tx1"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr><p:style><a:lnRef idx="2"><a:schemeClr val="accent1"><a:shade val="50000"/></a:schemeClr></a:lnRef><a:fillRef idx="1"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="0"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/><a:endParaRPr lang="en-US"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="45" name="TextBox 44"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="507996" y="10279602"/><a:ext cx="7680960" cy="11295400"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>Saudi Arabia faces significant challenges in consistent traffic enforcement, especially in rural or remote areas lacking camera infrastructure. With over 400,000 traffic accidents and approximately 7,000 fatalities annually, current systems fall short in ensuring road safety across the Kingdom.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>This project proposes an innovative, camera-free traffic monitoring solution using an IoT-based speed detector integrated with a mobile application. The system will monitor speeding, reckless driving, lane violations, and other unsafe behaviors using mobile technology, GPS, Bluetooth, and remote sensors. It aims to fill the enforcement gap in underserved regions, reduce dependence on costly camera installations, and promote safer driving habits.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>The app provides real-time alerts and warnings to drivers, helping prevent violations and accidents. It also supports law enforcement by automatically collecting and transmitting violation data, reducing manual intervention and paperwork.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>Unlike unregulated apps like </a:t></a:r><a:r><a:rPr lang="en-US" sz="2400" dirty="0" err="1"/><a:t>Radarbot</a:t></a:r><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t> or Google Maps, this solution is designed with a focus on legal compliance and public safety, offering a scalable, cost-effective alternative aligned with Saudi Arabia’s infrastructure modernization efforts.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>Ultimately, the project seeks to reduce accidents, ease traffic congestion, and ensure safer roads by leveraging smart technology instead of relying solely on physical enforcement methods.</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:endParaRPr lang="en-US" sz="2400" dirty="0"/></a:p><a:p><a:pPr algn="just"/><a:endParaRPr lang="en-US" sz="2400" dirty="0"/></a: