979"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="just"/><a:r><a:rPr lang="en-US" sz="2400" dirty="0"/><a:t>Saudi Arabia’s current traffic enforcement depends heavily on fixed-speed cameras, which are often absent in rural and remote areas. This lack of coverage allows many violations to go undetected, increasing the risk of accidents and reckless driving. Additionally, the cost of installing and maintaining camera infrastructure across the Kingdom is high, and many drivers avoid detection by using third-party apps or memorizing camera locations. Our project solves this issue by introducing an IoT-based speed monitoring system that works from inside the vehicle using GPS and Bluetooth, allowing real-time tracking and instant alerts anywhere—without relying on roadside cameras. This approach enhances road safety, promotes responsible driving, and supports Vision 2030's goals for smarter, safer infrastructure.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="18" name="Picture 17"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{64AB867F-015E-96A4-9752-6CB2836C2596}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId6"/><a:srcRect t="10468" r="3049" b="16931"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="1406062" y="31932388"/><a:ext cx="5511208" cy="1411762"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:ln><a:solidFill><a:schemeClr val="tx1"/></a:solidFill></a:ln></p:s